{
  "name": "mr-trainer-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "smoke:procedure": "tsx scripts/smoke-procedure.ts",
    "smoke:zerog": "tsx --env-file-if-exists=.env scripts/smoke-zerog.ts",
    "smoke:tts": "tsx --env-file-if-exists=.env scripts/smoke-tts.ts",
    "smoke:latency": "tsx --env-file-if-exists=.env scripts/smoke-latency.ts",
    "smoke:observe": "tsx scripts/smoke-observe.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
