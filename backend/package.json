{
  "name": "mr-trainer-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "smoke:procedure": "tsx scripts/smoke-procedure.ts",
    "smoke:zerog": "tsx --env-file-if-exists=.env scripts/smoke-zerog.ts",
    "smoke:tts": "tsx --env-file-if-exists=.env scripts/smoke-tts.ts",
    "smoke:latency": "tsx --env-file-if-exists=.env scripts/smoke-latency.ts",
    "smoke:observe": "tsx scripts/smoke-observe.ts",
    "smoke:episode": "tsx scripts/smoke-episode.ts",
    "smoke:evidence": "tsx --env-file-if-exists=.env scripts/smoke-evidence.ts",
    "smoke:ens-scope": "tsx --env-file-if-exists=.env scripts/smoke-ens-scope.ts",
    "smoke:ens": "tsx --env-file-if-exists=.env scripts/smoke-ens.ts",
    "ens:setup": "tsx --env-file-if-exists=.env scripts/ens-setup.ts",
    "ens:grant-profile": "tsx --env-file-if-exists=.env scripts/ens-grant-profile.ts",
    "proof": "tsx --env-file-if-exists=.env scripts/proof.ts",
    "ens:status": "tsx --env-file-if-exists=.env scripts/ens-status.ts",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "compile:registry": "tsx scripts/compile-registry.ts",
    "deploy:registry": "tsx --env-file-if-exists=.env scripts/deploy-registry.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.13",
    "ethers": "^6.13.1",
    "fastify": "^5.0.0",
    "solc": "^0.8.38",
    "undici": "^7.30.2",
    "viem": "^2.57.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
